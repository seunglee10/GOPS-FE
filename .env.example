# GOPS frontend 환경 변수.
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. Vite 는 저장소 루트에서 .env 를 읽습니다.

# vite dev server 가 /api, /ws 요청을 넘길 백엔드 주소.
# gops-backend 저장소를 로컬에서 띄웠다면 기본값 그대로 두면 됩니다.
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# logo.dev 기업 로고 API. 키가 없으면 로고는 폴백 렌더링됩니다.
LOGODEV_PUB_KEY=
VITE_LOGO_DEV_PUBLISHABLE_KEY=
VITE_LOGO_DEV_ATTRIBUTION=true

# 개발용 고정 fixture 로 AI 코치 / 기업 분석 패널을 채웁니다 (백엔드 없이 UI 확인용).
VITE_AI_COACH_DEV_FIXTURE=
VITE_COMPANY_ANALYSIS_DEV_FIXTURE=
